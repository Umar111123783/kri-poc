# Audit Monitor API Configuration
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Security & CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Persistence & Static Assets (optional overrides)
DATA_DIR=./data
STATIC_DIR=../frontend/dist
