{
  "version": "2.0.0",
  "tasks": [
    { "label": "install: backend", "type": "shell", "command": "pip install -r requirements-dev.txt", "options": { "cwd": "${workspaceFolder}/backend" } },
    { "label": "install: frontend", "type": "shell", "command": "npm install", "options": { "cwd": "${workspaceFolder}/frontend" } },
    { "label": "test: backend", "type": "shell", "command": "pytest -q", "options": { "cwd": "${workspaceFolder}/backend" }, "group": "test" },
    { "label": "build: frontend", "type": "shell", "command": "npm run build", "options": { "cwd": "${workspaceFolder}/frontend" }, "group": "build" }
  ]
}
